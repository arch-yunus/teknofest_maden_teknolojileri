<?xml version="1.0" ?>
<!--
  DeepMine AI - Gazebo Yer Altı Maden Gelerisi Dünyası
  TEKNOFEST 2026 Maden Teknolojileri Yarışması
  Tema 4.2.1: Otonom Navigasyon ve İnsansız Maden Araçları

  Bu SDF dünyası; dar galerileri, anroşman bloklarını ve
  farklı aydınlatma koşullarını simüle ederek Explorer Node'un
  GPS-free navigasyon yeteneğini doğrulamak için kullanılır.
-->
<sdf version="1.9">
  <world name="mine_gallery">

    <!-- ── Fizik Motoru ── -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Ortam Işığı (Yer altı - karanlık) ── -->
    <light name="ambient_mine" type="ambient">
      <cast_shadows>false</cast_shadows>
      <diffuse>0.05 0.05 0.05 1.0</diffuse>
      <specular>0.01 0.01 0.01 1.0</specular>
    </light>

    <!-- ── Galeri Başı (Giriş) Işığı ── -->
    <light name="entrance_light" type="point">
      <pose>0 0 2.5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.7 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <attenuation>
        <range>8.0</range>
        <constant>0.2</constant>
        <linear>0.1</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
    </light>

    <!-- ══════════════════════════════════════════════
         ANA GALERİ (30m uzunluk, 3m genişlik, 3m yükseklik)
         ══════════════════════════════════════════════ -->

    <!-- Taban -->
    <model name="floor">
      <static>true</static>
      <pose>15 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>30 4 0.1</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>30 4 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.2 1</ambient>
            <diffuse>0.4 0.35 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sol Duvar -->
    <model name="left_wall">
      <static>true</static>
      <pose>15 2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>30 0.2 3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>30 0.2 3</size></box></geometry>
          <material>
            <ambient>0.35 0.3 0.25 1</ambient>
            <diffuse>0.45 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sağ Duvar -->
    <model name="right_wall">
      <static>true</static>
      <pose>15 -2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>30 0.2 3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>30 0.2 3</size></box></geometry>
          <material>
            <ambient>0.35 0.3 0.25 1</ambient>
            <diffuse>0.45 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tavan -->
    <model name="ceiling">
      <static>true</static>
      <pose>15 0 3.05 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>30 4 0.1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>30 4 0.1</size></box></geometry>
          <material>
            <ambient>0.3 0.28 0.25 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Kapalı Uç (Galeri sonu) -->
    <model name="gallery_end">
      <static>true</static>
      <pose>30.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 4 3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 4 3</size></box></geometry>
          <material>
            <ambient>0.45 0.4 0.3 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════
         YAN GALERİ (10m uzunluk - T kavşak)
         ══════════════════════════════════════════════ -->

    <model name="side_gallery_floor">
      <static>true</static>
      <pose>15 -7 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>3 10 0.1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>3 10 0.1</size></box></geometry>
          <material>
            <ambient>0.3 0.25 0.2 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════
         ENGELLER (Kaya Blokları ve Ekipmanlar)
         ══════════════════════════════════════════════ -->

    <!-- Kaya Bloğu 1 -->
    <model name="rock_block_1">
      <static>true</static>
      <pose>8 0.5 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.2 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.2 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.25 0.22 0.18 1</ambient>
            <diffuse>0.35 0.3 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Kaya Bloğu 2 -->
    <model name="rock_block_2">
      <static>true</static>
      <pose>18 -0.8 0.35 0 0 -0.2</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.9 0.7 0.7</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.9 0.7 0.7</size></box></geometry>
          <material>
            <ambient>0.28 0.24 0.2 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Maden Arabası (Engel) -->
    <model name="mine_cart">
      <static>true</static>
      <pose>24 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.8 1.0 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.8 1.0 1.0</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.25 1</ambient>
            <diffuse>0.3 0.3 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════
         BAŞLANGIÇ POZİSYONU (Robot spawn noktası)
         ══════════════════════════════════════════════ -->

    <!-- Spawn marker (görsel) -->
    <model name="start_marker">
      <static>true</static>
      <pose>1 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.3</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.0 0.8 0.0 0.8</ambient>
            <diffuse>0.0 1.0 0.0 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hedef marker (görsel) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>26 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.3</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.0 0.0 0.8</ambient>
            <diffuse>1.0 0.0 0.0 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
