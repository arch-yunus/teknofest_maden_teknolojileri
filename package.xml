<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>teknofest_maden_teknolojileri</name>
  <version>1.0.0</version>
  <description>
    DeepMine AI: TEKNOFEST 2026 Maden Teknolojileri Yarışması
    Tema 4.2 - Otonom Madencilik, Yapay Zeka Entegrasyonu ve İş Güvenliği.
    GPS-free LiDAR SLAM navigasyon, Hibrit GPR-NN Rezerv Tahmini ve
    IoT tabanlı akıllı İSG takip sistemi içerir.
  </description>
  <maintainer email="bahattin@example.com">Bahattin Yunus</maintainer>
  <license>MIT</license>

  <!-- Build Tool Bağımlılıkları -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- C++ ROS 2 Bağımlılıkları (Otonom Navigasyon) -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Python ROS 2 Bağımlılıkları (AI Modeller, İSG) -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- Test Bağımlılıkları -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep8</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
